# Spike build artifacts
/spikes/**/build/*.so
/spikes/**/build/*.dylib
/spikes/**/build/*.dll
/spikes/**/*.db
/spikes/**/*.exe
/spikes/**/main
/spikes/**/main_modernc

# Athanor runtime state (never committed)
/state/
/backups/
/workspace/
*.db
*.db-wal
*.db-shm

# Local daemon configuration (copy config.example.yaml to start)
/config.yaml

# Keep spike source code and docs
!/spikes/**/*.go
!/spikes/**/go.mod
!/spikes/**/go.sum
!/spikes/**/README.md
